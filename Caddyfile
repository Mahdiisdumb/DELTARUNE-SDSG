:{$PORT}

root * .
encode gzip zstd

# Custom MIME types for WebAssembly / Emscripten game data
@wasm_files path *.wasm
header @wasm_files Content-Type application/wasm

@data_files path *.data *.mem *.symbols.json *.unx *.pak
header @data_files Content-Type application/octet-stream

# Universal Response Headers
header {
    # 1. Force HTTPS upgrades directly via CSP
    Content-Security-Policy "upgrade-insecure-requests; default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: * blob:; connect-src 'self' https: * blob:; media-src 'self' https: * blob:; font-src 'self' data: https: *; object-src 'none'; frame-src 'self' https: * blob:;"
    
    # 2. Isolation policies required for SharedArrayBuffer / WebAssembly
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Cross-Origin-Resource-Policy "cross-origin"
    
    # 3. Enable CORS for cross-domain Web Workers and CDN fetching
    Access-Control-Allow-Origin "*"
    Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Access-Control-Allow-Headers "*"
    
    # Security Defaults
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
}

# SPA Fallback Routing: Checks file existence first, then directory, then falls back to /index.html
try_files {path} {path}/ /index.html

# File Server
file_server